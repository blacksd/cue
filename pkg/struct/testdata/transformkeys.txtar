-- in.cue --
import "struct"

// Basic kebab-to-camel conversion.
basic: struct.TransformKeys({
	"max-queue-size": int
	"db-type":        string
	name:             string
}, "kebabToCamel")

// Recursive transformation of nested structs.
nested: struct.TransformKeys({
	"circuit-breaker": {
		"open-duration": int
		"failure-threshold": {
			count:            int
			"sliding-window": int
		}
	}
}, "kebabToCamel")

// Optional fields remain optional.
optional: struct.TransformKeys({
	"max-connections"?: int
	"db-host"?:         string
	name:               string
}, "kebabToCamel")

// sanitizeKoala: strip dollar prefix.
sanitizeBasic: struct.TransformKeys({
	"$listener": string
	"$name":     string
	"db-host":   string
	name:        string
}, "sanitizeKoala")

// sanitizeKoala recursive.
sanitizeNested: struct.TransformKeys({
	"$listener": string
	config: {
		"$name": string
		port:    int
	}
}, "sanitizeKoala")

// sanitizeKoala: drop text content marker ($$), keep other $ fields.
sanitizeDropTextContent: struct.TransformKeys({
	"$$":        string
	"$listener": string
	name:        string
}, "sanitizeKoala")

// sanitizeKoala: drop XML namespace declarations.
sanitizeDropXmlns: struct.TransformKeys({
	"$xmlns:xsi":                       string
	"$xsi:noNamespaceSchemaLocation":   string
	"$listener":                        string
	name:                               string
}, "sanitizeKoala")

// sanitizeKoala: $+kebab hybrid strips $ but preserves hyphens.
sanitizeKebabHybrid: struct.TransformKeys({
	"$clear-client-password-on-connection": bool
	"$listener":                            string
	name:                                   string
}, "sanitizeKoala")

// Composition: sanitizeKoala then kebabToCamel, including $$ drop and $+kebab hybrid.
composed: struct.TransformKeys(struct.TransformKeys({
	"$listener":                            string
	"$name":                                string
	"$$":                                   string
	"$clear-client-password-on-connection": bool
	"db-host":                              string
	"max-retries":                          int
}, "sanitizeKoala"), "kebabToCamel")

// kebabToCamel does not strip dollar prefix.
kebabKeepsDollar: struct.TransformKeys({
	"$listener": string
	"db-host":   string
}, "kebabToCamel")

// Already-camelCase names pass through unchanged.
passthrough: struct.TransformKeys({
	name:    string
	enabled: bool
	port:    int
}, "kebabToCamel")

// Definition with type references.
#Threshold: {
	count:  int & >=1
	window: int & >=1
}

defRef: struct.TransformKeys({
	"open-duration":       int
	"failure-threshold"?: #Threshold
}, "kebabToCamel")

// Empty struct.
empty: struct.TransformKeys({}, "kebabToCamel")

// Invalid transform name.
invalid: struct.TransformKeys({a: 1}, "unknownTransform")

// Combined with FilterByAttr.
#Config: {
	"retained-messages"?: {
		enabled?: bool @visibility("customer")
	} @visibility("customer")
	"queued-messages"?: {
		"max-queue-size"?: int @visibility("product")
	} @visibility("product")
	"keep-alive"?: {
		"max-keep-alive"?:  int  @visibility("customer")
		"allow-unlimited"?: bool @visibility("customer")
	} @visibility("customer")
}

combined: struct.TransformKeys(
	struct.FilterByAttr(#Config, "visibility", "customer"),
	"kebabToCamel",
)
-- out/structs-v3 --
Errors:
invalid: error in call to struct.TransformKeys: TransformKeys: unknown transform "unknownTransform":
    ./in.cue:105:10

Result:
