#Config: {
	"retained-messages"?: {
		enabled?: bool @visibility("customer")
	} @visibility("customer")
	"queued-messages"?: {
		"max-queue-size"?: int @visibility("product")
	} @visibility("product")
	"keep-alive"?: {
		"max-keep-alive"?:  int  @visibility("customer")
		"allow-unlimited"?: bool @visibility("customer")
	} @visibility("customer")
}
